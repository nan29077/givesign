# ---------------------------------------------------------------------------
# BASIC 환경변수 예시. 실제 값은 .env 또는 AWS Secrets Manager 로 주입한다.
# 어떤 키도 소스코드/로그/프론트엔드에 하드코딩하지 않는다.
# ---------------------------------------------------------------------------

# --- 기본 ---
PORT="3060"
APP_ENV="local"                       # local | staging | prod (미설정·오타는 안전하게 prod 로 간주)
APP_BASE_URL="http://localhost:3060"
APP_TIMEZONE="Asia/Seoul"

# --- 데이터베이스 (AWS RDS / Aurora PostgreSQL) ---
# 운영: postgresql://user:pass@givesign.cluster-xxxx.ap-northeast-2.rds.amazonaws.com:5432/givesign?schema=public&sslmode=require&connection_limit=10
DATABASE_URL="postgresql://givesign:givesign@127.0.0.1:5462/givesign?schema=public"
# RDS Proxy / PgBouncer 경유 시 사용 (마이그레이션은 DIRECT_DATABASE_URL 사용)
DIRECT_DATABASE_URL=""

# --- 이미지 저장소 ---
# local = 서버 로컬 디스크(var/uploads). 단일 서버 전용.
# s3    = Amazon S3. 다중 인스턴스/재배포에도 이미지가 유지된다. **운영 필수**
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_PREFIX="uploads"
# CloudFront 등 공개 배포 도메인. 비우면 /api/media 라우트를 경유해 서빙한다.
S3_PUBLIC_BASE=""

# --- 드리프트 탐지용 섀도 DB (CI 에서만 사용) ---
# prisma migrate diff --from-migrations 로 스키마-마이그레이션 불일치를 검사할 때 필요하다.
SHADOW_DATABASE_URL=""

# --- Redis (ElastiCache) ---
REDIS_URL="redis://127.0.0.1:6390"
# Redis 미설치 환경에서 인메모리 폴백 허용 (운영에서는 false)
ALLOW_INMEMORY_FALLBACK="true"

# --- 암호화 (로컬 전용. 운영은 AWS KMS 사용) ---
CRYPTO_PROVIDER="local"               # local | aws-kms
# 32바이트 base64. openssl rand -base64 32
CRYPTO_MASTER_KEY="ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hIQ=="
PHONE_HASH_SECRET="dev-only-phone-hmac-secret-change-me"
SESSION_SECRET="dev-only-session-secret-change-me-please"
AWS_REGION="ap-northeast-2"
AWS_KMS_KEY_ID=""

# --- 결제: 헥토파이낸셜 내통장결제(EzAuth) ---
PAYMENT_PROVIDER="mock"               # mock | hecto
HECTO_MID=""
HECTO_LICENSE_KEY=""
HECTO_AES_KEY=""
HECTO_HASH_KEY=""
# 내통장결제(EzAuth)는 결제창 호스트와 서버 API 호스트가 다르다. 절대 합치지 말 것.
HECTO_AUTH_UI_BASE="https://ezauth.settlebank.co.kr"          # 결제창 + SettlePay.js
HECTO_AUTH_API_BASE="https://ezauthapi.settlebank.co.kr:8081" # 승인/빌키 API
HECTO_CALLBACK_URL="${APP_BASE_URL}/api/payments/hecto/return"
HECTO_RETURN_URL="${APP_BASE_URL}/api/payments/hecto/return"
HECTO_NOTI_URL="${APP_BASE_URL}/api/payments/hecto/notify"
# 결제인증 후 승인 API 호출 제한(공식 10분)보다 짧게 설정
PAYMENT_CONFIRM_TTL_SEC="300"
# PIN 입력 링크 유효시간 (초). 결제사 인증창 유효시간(10분)을 넘기지 않는다.
PAYMENT_PIN_TTL_SEC="300"
# PIN 완료 콜백(X-Pin-Secret) 검증용 공유 비밀. 운영에서는 필수이며 비어 있으면 기동이 중단된다.
# (로컬에서만 비워 둘 수 있다. 실연동 시 결제사 서명 검증으로 교체한다)
PAYMENT_PIN_CALLBACK_SECRET=""
# PIN 완료 콜백에서 "인증 성공"으로 인정할 결과코드 (콤마 구분, 대소문자 무관).
# 이 목록에 없는 코드는 인증 실패로 처리되며 승인(출금)을 실행하지 않는다.
# ※ 아래 기본값은 mock 검수용이다. 운영에서는 결제사 규격의 실제 성공 코드로 반드시 교체해야 하며,
#   미설정이거나 MOCK 이 남아 있으면 기동이 중단된다.
PAYMENT_PIN_SUCCESS_CODES="0000,OK,SUCCESS,MOCK"
# PIN 완료 콜백을 보낼 수 있는 결제사 IP (콤마 구분).
# 공유 비밀이 유출돼도 아무 데서나 출금 통지를 만들 수 없게 하는 2중 방어다.
# APP_ENV=local 에서만 비워둘 수 있다(운영은 fail-closed).
PIN_CALLBACK_IPS=""

# --- MO 문자 수신 ---
MO_PROVIDER="mock"                    # mock | mtonet   (EMMA 는 웹훅이 아니라 폴링이라 아래 EMMA_* 를 쓴다)
MO_WEBHOOK_SECRET="dev-only-mo-webhook-secret"
MO_ALLOWED_IPS=""                     # 콤마 구분. APP_ENV=local 에서만 비워둘 수 있다(운영은 fail-closed)
#                                       ::ffff:1.2.3.4 같은 IPv6 매핑 표기는 자동으로 정규화된다
# 같은 번호가 같은 사회복지기관에 문자를 반복해 보낼 때의 폭주 상한.
# 1차 방어는 "직전 금액 선택 링크가 아직 유효하면 다시 보내지 않는다" 이고, 아래는 그 위의 안전판이다.
# 정상 후원자가 닿을 수 없는 값으로 둔다. 0 이면 상한을 쓰지 않는다.
MO_CHARGE_THROTTLE_WINDOW_SEC="1800"
MO_CHARGE_THROTTLE_MAX="10"
# --- MTONET 050 / MO ---
MTONET_USER_ID=""
MTONET_API_KEY=""

# --- EMMA (인포뱅크 온프레미스 SMS 에이전트) ---
# EMMA 는 HTTP 웹훅을 보내지 않는다. 자기 DB 테이블에 직접 읽고 쓰므로,
#   MO(수신) = em_mo_log_YYYYMM 폴링   → GET /api/cron/emma-mo (Bearer ${CRON_SECRET}, 10~15초 주기)
#   MT(발신) = em_smt_tran 큐 적재     → MT_PROVIDER="emma"
# 로 붙는다. 켜면 MO_WEBHOOK_SECRET / MO_ALLOWED_IPS 는 쓰이지 않는다.
EMMA_ENABLED="false"
# EMMA 전용 DB 접속 URL. 비우면 앱과 같은 DB 를 쓴다.
# EMMA 는 테이블·프로시저 생성 권한을 요구하므로 **분리를 권장**한다
# (정산 원장·암호화 빌키가 있는 DB 에 DDL 권한 데몬을 붙이지 않는다).
EMMA_DB_URL=""
EMMA_DB_POOL_MAX="4"
# 계약한 대표번호(숫자만). 설정하면 이 대표번호로 들어온 수신만 처리한다.
# 한 EMMA 에 여러 서비스 번호가 물린 구성에서 서로의 문자를 가로채는 사고를 막는 안전판.
EMMA_MO_BASE_NUMBER=""
# EMMA 이중화 인스턴스 ID(2자리). **이중화를 실제로 쓸 때만** 설정한다.
# EMMA 설정값과 다르면 MT 가 큐에 쌓이기만 하고 발송되지 않는다.
EMMA_ID=""
EMMA_MO_BATCH_SIZE="200"
EMMA_MO_STALE_SEC="300"

# --- MT 문자 발송 ---
MT_PROVIDER="mock"                    # mock | coolsms | emma
MT_API_KEY=""                         # 문자 사업자 API 키 (coolsms)
MT_API_SECRET=""                      # 문자 사업자 API 시크릿 (coolsms, HMAC 서명용)
MT_FROM_NUMBER="15881234"             # 발신번호 사전등록 완료 번호
MT_SENDER_NUMBER=""                   # 사업자에 등록한 발신번호. 비우면 MT_FROM_NUMBER 를 사용한다

# 일일 할당량 가드 (실측 후 조정)

# --- 소셜 간편 로그인 (카카오 / 네이버) ---
# 키가 비어 있으면 화면에 "연동 준비 중"으로 표시되고 로그인은 진행되지 않는다.
# 카카오: 카카오 디벨로퍼스 > 앱 > REST API 키, 카카오 로그인 Redirect URI 등록
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="${APP_BASE_URL}/api/auth/social/kakao/callback"
# 네이버: 네이버 개발자센터 > 애플리케이션 등록 > Client ID/Secret, Callback URL 등록
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NAVER_REDIRECT_URI="${APP_BASE_URL}/api/auth/social/naver/callback"

# --- 객체 저장소 ---
S3_BUCKET=""
S3_PUBLIC_BASE=""

# --- 정리 배치 스케줄러 ---
# AWS EventBridge Scheduler 등 외부 크론이 1분 간격으로 호출한다.
#   GET ${APP_BASE_URL}/api/cron/cleanup   Authorization: Bearer ${CRON_SECRET}
# 만료된 PIN 인증/확인 링크 자동 취소와 만료 멱등키 삭제를 수행한다.
#
# 자동 정산 지급 배치는 별도 엔드포인트다. **하루 한 번, 은행 영업시간 안(예: 평일 10:00 KST)** 에만 호출한다.
#   GET ${APP_BASE_URL}/api/cron/payout    Authorization: Bearer ${CRON_SECRET}
# 돈이 나가는 배치라 겹쳐 도는 것을 서버에서 잠금으로 막지만, 스케줄 자체를 1일 1회로 두는 것이 먼저다.
#
# 비어 두면 로컬(APP_ENV=local)에서만 호출이 허용되고 그 외 환경에서는 전건 401 로 거절된다.
CRON_SECRET=""

# --- 지급대행 (정산금 이체) ---
# mock 이면 실제 이체가 일어나지 않고 화면·로그에 mock 임을 명시한다. 계약 전까지 mock 을 유지한다.
PAYOUT_PROVIDER="mock"
PAYOUT_API_BASE=""
PAYOUT_API_KEY=""
# 이 금액 미만이면 지급하지 않고 다음 지급 회차로 이월한다(소액 이체 수수료 방지).
PAYOUT_MIN_AMOUNT="1000"

# --- 운영 안전장치 ---
# DIRECT_TRIGGER 모드는 금융사 서면승인 등록 전에는 절대 활성화하지 않는다
ALLOW_DIRECT_TRIGGER="false"
# 실제 결제/실제 MT 발송 차단 스위치 (승인 전 true 유지)
SAFE_MODE="true"
# 정기후원 자동 출금 실행 허용. 실결제사에서는 금융사 승인 뒤에만 true. mock 결제사는 값과 무관하게 실행된다.
ALLOW_RECURRING_DEBIT="false"
# 정기후원·정리 배치 호출 비밀. 운영(NODE_ENV=production)에서는 비어 있으면 부팅이 거부된다.
#   GET ${APP_BASE_URL}/api/cron/recurring  Authorization: Bearer ${CRON_SECRET}  (매일 1회, 예: 09:00 KST)

# --- 기능 스위치 ---
# 실물 상품·배송·문서 상품 기능(메시지페이에서 물려받음). 사회복지기관 기본 업무가 아니라 기본은 꺼져 있다.
# true 로 켜면 후원 항목 관리에 실물·문서 탭, 후원 설정에 배송 정책 탭, 주문·문서 관리 메뉴가 보인다.
FEATURE_GOODS="false"

# 기브싸인 내장 미리보기 DB
PGLITE_PORT="5463"
